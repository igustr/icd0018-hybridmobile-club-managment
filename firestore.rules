rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isCoach() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return signedIn()
        && user.data.role is string
        && user.data.role.lower() == "coach";
    }

    function isPlayer() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return signedIn()
        && user.data.role is string
        && user.data.role.lower() == "player";
    }

    function userTeamIds() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return signedIn() && user.data.teamIds is list
        ? user.data.teamIds
        : [];
    }

    function belongsToTeam(teamId) {
      return teamId != null
        && teamId in userTeamIds();
    }

    function isCoachOfTeam(teamId) {
      return isCoach()
        && teamId != null
        && get(/databases/$(database)/documents/teams/$(teamId)).exists
        && (
          (
            get(/databases/$(database)/documents/teams/$(teamId)).data.coachIds is list
            && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.coachIds
          )
          || (
            get(/databases/$(database)/documents/teams/$(teamId)).data.coachId is string
            && get(/databases/$(database)/documents/teams/$(teamId)).data.coachId == request.auth.uid
          )
        );
    }

    function eventDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId));
    }

    function eventOnUserTeam(eventId) {
      return eventDoc(eventId).exists
        && (belongsToTeam(eventDoc(eventId).data.teamId) || isCoachOfTeam(eventDoc(eventId).data.teamId));
    }

    // Users: role immutable from client; only create as player
    match /users/{userId} {
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == "player";

      // Allow reading any user profile (for attendance view, team roster)
      allow read: if signedIn();

      // Users can update own profile; coaches can update any user's teamIds
      allow update: if signedIn()
        && request.resource.data.role == resource.data.role
        && (userId == request.auth.uid || isCoach());

      allow delete: if false;
    }

    // Clubs: only coaches can create/update; no embedded owner field
    match /clubs/{clubId} {
      allow read: if signedIn();
      allow create: if isCoach();
      allow update: if isCoach();
      allow delete: if false;
    }

    // Teams: visible to any signed-in user (used for lookups), write still restricted to coaches
    match /teams/{teamId} {
      allow read: if signedIn();
      allow create: if isCoach()
        && request.resource.data.coachIds is list
        && request.auth.uid in request.resource.data.coachIds;
      allow update: if isCoach()
        && resource.data.coachIds is list
        && request.auth.uid in resource.data.coachIds;
      allow delete: if false;
    }

    // Events: readable by team members (players see all types); coach-managed for their teams
    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if isCoach()
        && request.resource.data.createdByUserId == request.auth.uid;
      allow update, delete: if isCoach()
        && (belongsToTeam(resource.data.teamId) || isCoachOfTeam(resource.data.teamId))
        && resource.data.createdByUserId == request.auth.uid;
    }

    // Attendance: players manage own status; coaches can read all
    match /attendance/{attendanceId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.resource.data.playerId == request.auth.uid;

      allow delete: if false;
    }

    // Conversations: read/write if participant
    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow delete: if false;
    }

    // Messages: read if signed in, create if sender matches
    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // Unread counts: read own, any signed-in user can increment (for notifications)
    match /users/{userId}/unread/{conversationId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow write: if signedIn();
    }
  }
}
